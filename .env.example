# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional AI-assisted interpretation. Keep disabled until one provider below
# has both a server-only API key and a model configured.
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_PROVIDER=openai
AI_ANALYSIS_PROMPT_VERSION=v1

OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=

# Maximum completed generations per result in a rolling 24-hour window.
AI_ANALYSIS_MAX_REGENERATIONS=3
# Maximum completed or failed provider attempts per result in the same window.
AI_ANALYSIS_MAX_ATTEMPTS=6
AI_ANALYSIS_CONTEXT_MAX_CHARS=2000
AI_ANALYSIS_TIMEOUT_MS=60000

# Development evaluation harness only. Ordinary tests never make live AI calls.
RUN_LIVE_AI_EVALS=false
